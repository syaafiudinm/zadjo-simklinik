APP_NAME=SIMKlinik
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Makassar
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Domain pusat (landing, admin vendor). Subdomain di bawahnya = tenant.
# `.localhost` dipilih karena Chrome/Safari/Firefox meresolve *.localhost ke
# 127.0.0.1 tanpa perlu dnsmasq atau /etc/hosts.
APP_URL=http://simklinik.localhost:8000
CENTRAL_DOMAIN=simklinik.localhost
CENTRAL_DOMAINS=simklinik.localhost,admin.simklinik.localhost,localhost,127.0.0.1

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database pusat -------------------------------------------------------
# Berisi registry tenant, langganan, dan master data global. TIDAK PERNAH
# berisi data klinis.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=simklinik_central
# User terbatas: hanya berhak atas database pusat, TIDAK bisa membaca
# database klinik. Dibuat oleh `make db-users`.
DB_USERNAME=simklinik
DB_PASSWORD=simklinik-lokal

# Admin server MySQL: membuat database & user tenant, grant, migrasi tenant.
# Koneksi pusat sehari-hari tidak pernah memakainya.
TENANCY_ADMIN_DB_USERNAME=root
TENANCY_ADMIN_DB_PASSWORD=secret

# Database per-tenant dibuat runtime oleh provisioning (S1-04) memakai
# kredensial di atas. Nama database = prefix + tenant id + suffix.
TENANCY_DB_PREFIX=simklinik_
TENANCY_DB_SUFFIX=
# Awalan user MySQL per tenant (S1-04). Tiap tenant punya user sendiri dengan
# grant yang hanya berlaku di databasenya.
TENANCY_DB_USER_PREFIX=sk_

# Port yang dipetakan docker-compose ke host.
DOCKER_MYSQL_PORT=3307
DOCKER_REDIS_PORT=6379
DOCKER_MAILPIT_SMTP_PORT=1025
DOCKER_MAILPIT_UI_PORT=8025

SESSION_DRIVER=redis
# Batas umur sesi di store. Auto-logout karena idle (FR-M21.6) ditegakkan
# terpisah oleh middleware EnforceIdleTimeout dan bisa diatur per klinik.
SESSION_LIFETIME=120
SESSION_IDLE_TIMEOUT=15
SESSION_ENCRYPT=false
SESSION_PATH=/
# Dibiarkan null: cookie sesi terikat ke host persis, sehingga sesi tenant A
# secara struktural tidak terkirim ke subdomain tenant B.
SESSION_DOMAIN=null

# Akses baca rekam medis yang sama oleh orang yang sama dalam jendela ini
# dicatat sekali di jejak audit.
AUDIT_ACCESS_DEDUP_SECONDS=60

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
# Harus lebih besar dari timeout job terlama (provisioning: 170 detik).
REDIS_QUEUE_RETRY_AFTER=240

# Dashboard antrian: http://admin.simklinik.localhost:8000/horizon
# Kosongkan salah satu untuk menutup dashboard sepenuhnya.
HORIZON_BASIC_AUTH_USERNAME=operator
HORIZON_BASIC_AUTH_PASSWORD=ganti-di-produksi

CACHE_STORE=redis
CACHE_PREFIX=

# Ekstensi phpredis tidak terpasang di banyak mesin dev macOS, jadi default
# ke predis (pure PHP). Ganti ke `phpredis` di produksi untuk performa.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit (docker-compose) — buka http://localhost:8025 untuk melihat email.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="halo@simklinik.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
